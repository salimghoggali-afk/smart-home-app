{
  "rules": {
    ".read": false,
    ".write": false,
    "owner": {
      ".read": true,
      ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
    },
    "adminContact": {
      ".read": true,
      ".write": false
    },
    "members": {
      ".read": "auth != null && root.child('owner').val() === auth.uid",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('owner').val() === auth.uid"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('owner').val() === auth.uid)",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "homes": {
      ".read": "auth != null && (root.child('owner').val() === auth.uid || root.child('members').child(auth.uid).val() === true)",
      ".write": "auth != null && root.child('owner').val() === auth.uid",
      "$home": {
        "floors": {
          "$floor": {
            "lamps": {
              "$lamp": {
                "order": {
                  ".write": "auth != null && root.child('members').child(auth.uid).val() === true && data.parent().exists()",
                  ".validate": "newData.val() === 'none' || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100)"
                },
                "locked": {
                  ".write": "auth != null && root.child('members').child(auth.uid).val() === true && data.parent().exists()",
                  ".validate": "newData.val() === 'none' || newData.isBoolean()"
                },
                "mode": {
                  ".write": "auth != null && root.child('members').child(auth.uid).val() === true && data.parent().exists()",
                  ".validate": "newData.val() === 'dimmer' || newData.val() === 'switch'"
                },
                "state": {
                  ".write": "auth != null && root.child('members').child(auth.uid).val() === true && data.parent().exists()",
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
                },
                "lockstate": {
                  ".write": "auth != null && root.child('members').child(auth.uid).val() === true && data.parent().exists()",
                  ".validate": "newData.isBoolean()"
                }
              }
            }
          }
        }
      }
    }
  }
}
